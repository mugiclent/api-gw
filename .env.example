# Docker image — managed by CI/CD pipeline (do not edit manually in production)
DOCKER_USERNAME=ktshonln
IMAGE_TAG=latest

NODE_ENV=development
PORT=8090

# JWT — EdDSA public key (must match the private key used by user-service to sign tokens)
# Store PEM as single-line with literal \n separators
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# Routes config — raw URL to routes.yaml, polled for live updates
# Format: https://raw.githubusercontent.com/{owner}/{repo}/{branch}/{path}
# When routes.local.yaml exists in the working directory it takes precedence and
# GitHub is never contacted (used for local dev).
ROUTES_URL=https://raw.githubusercontent.com/ktshonln/katisha-config/main/api-gw/routes.yaml
# Fine-grained PAT with Contents: Read on the config repo. Leave empty for public repos.
ROUTES_TOKEN=
# How often to poll for config changes (ms). Default: 30000 (30 s)
ROUTES_POLL_INTERVAL_MS=30000

# User service — internal Docker URL (for JWKS proxy)
USER_SERVICE_URL=http://user-svc:8091

# CORS — comma-separated list of allowed origins, or * to allow all (dev only)
# Local dev: CORS_ORIGINS=*
# Production: CORS_ORIGINS=https://katisha.online,https://app.katisha.online
CORS_ORIGINS=https://katisha.online,https://app.katisha.online
